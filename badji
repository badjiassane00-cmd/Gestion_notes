#!/usr/bin/env php
<?php

$projetDir = __DIR__;

$envPath = $projetDir . '/.env';

if (!file_exists($envPath)) {
    echo "Aucun fichier .env trouvé." . PHP_EOL;
    exit(1);
}

$env = [];
foreach (file($envPath) as $ligne) {
    $ligne = trim($ligne);
    if ($ligne === '' || str_starts_with($ligne, '#')) {
        continue;
    }
    [$cle, $valeur] = explode('=', $ligne, 2);
    $env[trim($cle)] = trim($valeur);
}

$schemaPath = $projetDir . '/database/schema.sql';

if (!file_exists($schemaPath)) {
    echo "Aucun fichier database/schema.sql trouvé." . PHP_EOL;
    exit(1);
}

$host = $env['DB_HOST'] ?? 'localhost';
$port = $env['DB_PORT'] ?? '5432';
$dbname = $env['DB_NAME'] ?? null;
$user = $env['DB_USER'] ?? 'postgres';
$password = $env['DB_PASSWORD'] ?? '';

$commande = $argv[1] ?? null;

if ($commande !== 'execute') {
    echo "Utilisation : php Badji execute" . PHP_EOL;
    exit(1);
}

try {
    $dsn = "pgsql:host={$host};port={$port};dbname={$dbname}";
    $pdo = new PDO($dsn, $user, $password);
    $pdo->setAttribute(PDO::ATTR_ERRMODE, PDO::ERRMODE_EXCEPTION);

    $sql = file_get_contents($schemaPath);
    $pdo->exec($sql);

    echo "Migration exécutée avec succès sur la base {$dbname}." . PHP_EOL;
} catch (PDOException $e) {
    echo "Erreur : " . $e->getMessage() . PHP_EOL;
    exit(1);
}